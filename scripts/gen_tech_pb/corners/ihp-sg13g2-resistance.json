        "assumptions": [
          {
            "id": "poly-sheet",
            "description": "Use 6.2 Ohm/square for salicided GatPoly from the min interconnect table",
            "reason": "The interconnect RPSQ law is independent of the compact rsil model parameters",
            "source_ids": [
              "gatpoly-itf-min",
              "gatpoly-process-spec"
            ]
          },
          {
            "id": "mim-sheet",
            "description": "Use 13.36 Ohm/square for the MIM plate and TopVia1 resistance for its contact",
            "reason": "The nominal recipe derives the plate estimate from 0.5 MS/m and 0.1497 um and aliases the contact material",
            "source_ids": [
              "recipe"
            ]
          },
          {
            "id": "gatpoly-only",
            "description": "Vary only GatPoly sheet resistance; all other sheet/contact/via values remain explicitly nominal",
            "reason": "Isolate this material sensitivity without claiming a complete process resistance corner",
            "source_ids": [
              "recipe",
              "gatpoly-itf-min"
            ]
          },
          {
            "id": "fixed-layout",
            "description": "Apply sheet resistance to the existing extracted polygons without geometry, temperature or mismatch changes",
            "reason": "These are sheet-resistance sensitivity scenarios. The ITF also varies thickness and the process spec lists linewidth limits; neither defines a scalar correction for arbitrary drawn polygons",
            "source_ids": [
              "gatpoly-itf-min",
              "gatpoly-process-spec",
              "gatpoly-layout-rules"
            ]
          },
          {
            "id": "device-ownership",
            "description": "Recognized rsil/rppd/rhigh devices retain their own compact models; no compact-model width shift or series/contact term is applied to the extracted wire",
            "reason": "The LVS device boundary separates modeled resistor bodies from interconnect. Mixing the compact law with the interconnect RPSQ table would double-count device effects",
            "source_ids": [
              "recipe",
              "gatpoly-device-corners",
              "gatpoly-device-model"
            ]
          }
        ],
