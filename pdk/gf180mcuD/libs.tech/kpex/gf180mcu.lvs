#===!====!===!===!====!===!===!====!===!===!====!===!===!====!===!===!====!===!===!====!===
# WARNING: this version is not a regular LVS script,
#          instead tailored for parasitic extraction (PEX) by the klayout-pex tool
#===!====!===!===!====!===!===!====!===!===!====!===!===!====!===!===!====!===!===!====!===

########################################################################################
# GF180MCU LVS Runset Options
###=====================================================###
#--- ** Processing Options** ---
# input: Full path to layout file (required)
# topcell: Optional top cell name (defaults to active cell)
# target_netlist: Output path to layout extracted netlist
# schematic: Input schematic file path (.spice/.cdl)
# schematic_translate: Use workaround spice translation. Tested to work from xschem
#     spice. Will generate xxx_translated.spice in the layout directory
#     (true/false, default: false)
# report: Optional output report file path (defaults to layout directory, name
#     of topcell
###=====================================================###
#--- **Netlist Options** ---
# spice_net_names: Use net names instead of numbers (true/false, default: true)
# spice_comments: Include detailed comments (true/false, default: true)
###=====================================================###
#--- **LVS Options** ---
# simplify: Simplify netlist (true/false, default: false)
# net_only: Extract netlist only (true/false, default: false)
# top_lvl_pins: Generate top-level pins in the layout using named nets. check_ports
#     automatically turns it on. (true/false, default: false)
# combine: Combine devices (true/false, default: false)
# purge: Purge unused objects (true/false, default: false)
# purge_nets: Purge unused nets (true/false, default: false)
# implicit_connect: Use implicit connections (true/false, default: false)
# check_ports: Check inconsistently labelled or missing ports in the current top circuit (true/false, default: true)
###=====================================================###
#--- **Extraction Options** ---
# run_mode: [tiling/deep/flat] (default: flat)
# metal_top: Metal top layer (6K/9K/11K/30K, default: 9K)
# metal_level: Metal stack level (3LM/4LM/5LM/6LM, default: 6LM)
# poly_res: Poly resistor value (default: 1k)
# mim_option: MIM option (A/B, default: B)
# mim_cap: MIM capacitance (1/1.5/2, default: 2)
# consider_dn_dw_features: Extract _dn and _dw device models (true/false, default: false)
# verbose: Enable verbose mode (true/false, default: false)
###=====================================================###
# Example usage:
#   klayout -b -r gf180mcu.lvs -rd input=design.gds -rd report=lvs_results.lyrdb
#       -rd run_mode=deep
########################################################################################
#=======================================================================================================================
#--------------------------------------------- GF 0.18um MCU LVS RULE DECK ---------------------------------------------
#=======================================================================================================================
require 'English'
require 'time'
require 'logger'
require 'etc'
require 'tmpdir'

exec_start_time = Time.now

logger = Logger.new($stdout)

logger.formatter = proc do |_severity, datetime, _progname, msg|
  "#{datetime}: Memory Usage (" + `pmap #{Process.pid} | tail -1`[10, 40].strip + ") : #{msg}
"
end

#================================================
#----------------- FILE SETUP -------------------
#================================================
logger.info("Starting running GF180MCU Klayout LVS runset on #{$input}")
logger.info("Ruby Version for klayout: #{RUBY_VERSION}")

if $input
  if $topcell
    source($input, $topcell)
  else
    source($input)
  end
end

logger.info('Loading database to memory is complete.')

if $report
  logger.info("GF180MCU Klayout LVS runset output at: #{$report}")
  report_lvs($report)
else
  layout_dir = Pathname.new(RBA::CellView.active.filename).parent.realpath
  report_path = layout_dir.join("#{source.cell_name}.lvsdb").to_s
  logger.info("GF180MCU Klayout LVS runset output at default location: #{report_path}")
  report_lvs(report_path)
end

#================================================
#------------------ SWITCHES --------------------
#================================================
logger.info('Evaluate switches.')

def bool_check?(obj, default: false)
  return default if obj.nil?

  obj.to_s.downcase == 'true'
end

#=== SCHEMATIC TRANSLCATE ===

SCHEMATIC_TRANSLATE = bool_check?($schematic_translate)

logger.info("schematic translate: #{SCHEMATIC_TRANSLATE}")

#=== NET NAMES OPTION ===
# true: use net names instead of numbers
# false: use numbers for nets
SPICE_WITH_NET_NAMES = bool_check?($spice_net_names, default: true)

logger.info("Extracted netlist with net names: #{SPICE_WITH_NET_NAMES}")

#=== COMMENTS OPTION ===
# true: put in comments with details
# false: no comments
SPICE_WITH_COMMENTS = bool_check?($spice_comments, default: true)

logger.info("Extracted netlist with comments in details: #{SPICE_WITH_COMMENTS}")

#=== TARGET NETLIST ===
if $target_netlist
  logger.info("LVS extracted netlist at: #{$target_netlist}")
  target_netlist($target_netlist, write_spice(SPICE_WITH_NET_NAMES, SPICE_WITH_COMMENTS),
                 "Extracted by KLayout with GF180MCU LVS runset on : #{Time.now.strftime('%d/%m/%Y %H:%M')}")
else
  layout_dir = Pathname.new(RBA::CellView.active.filename).parent.realpath
  netlist_path = layout_dir.join("#{source.cell_name}_extracted.cir")
  target_netlist(netlist_path.to_s, write_spice(SPICE_WITH_NET_NAMES, SPICE_WITH_COMMENTS),
                 "Extracted by KLayout with GF180MCU LVS runset on : #{Time.now.strftime('%d/%m/%Y %H:%M')}")
  logger.info("GF180MCU Klayout LVS extracted netlist file at: #{source.cell_name}_extracted.cir")
end

# SIMPLIFY
SIMPLIFY = bool_check?($simplify)

logger.info("Selected SIMPLIFY option: #{SIMPLIFY}")

# NET_ONLY
NET_ONLY = bool_check?($net_only)

logger.info("Selected NET_ONLY option: #{NET_ONLY}")

# CHECK PORTS
CHECK_PORTS = bool_check?($check_ports, default: true)

logger.info("Selected CHECK_PORTS option: #{CHECK_PORTS}")

# TOP_LVL_PINS
TOP_LVL_PINS = bool_check?($top_lvl_pins) || CHECK_PORTS

logger.info("Selected TOP_LVL_PINS option: #{TOP_LVL_PINS}")

# COMBINE
COMBINE = bool_check?($combine)

logger.info("Selected COMBINE option: #{COMBINE}")

# PURGE
PURGE = bool_check?($purge)

logger.info("Selected PURGE option: #{PURGE}")

# PURGE_NETS
PURGE_NETS = bool_check?($purge_nets)

logger.info("Selected PURGE_NETS option: #{PURGE_NETS}")

# IMPLICIT_CONNECT
IMPLICIT_CONNECT = bool_check?($implicit_connect)

logger.info("Selected IMPLICIT_CONNECT option: #{IMPLICIT_CONNECT}")

# CONSIDER DN DW features
CONSIDER_DN_DW_FEATURES = bool_check?($consider_dn_dw_features)

logger.info("Selected CONSIDER_DN_DW_FEATURES option: #{CONSIDER_DN_DW_FEATURES}")

#=== PRINT DETAILS ===
logger.info("Verbose mode: #{$verbose}")
if $verbose == 'true'
  verbose(true)
else
  verbose(false)
end

# === TILING MODE ===
case $run_mode
when 'tiling'
  tiles(500.um)
  tile_borders(10.um)
  logger.info('Tiling  mode is enabled.')

when 'deep'
  #=== HIER MODE ===
  deep
  logger.info('deep  mode is enabled.')
else
  #=== FLAT MODE ===
  flat
  logger.info('flat  mode is enabled.')
end

# METAL_TOP
# [PEX] default of gf180mcuD (run_lvs.py --variant=D), as KPEX passes no variant
METAL_TOP = $metal_top || '11K'

logger.info("METAL_TOP Selected is #{METAL_TOP}")

# METAL_LEVEL
# [PEX] default of gf180mcuD (run_lvs.py --variant=D), as KPEX passes no variant
METAL_LEVEL = $metal_level || '5LM'

logger.info("METAL_STACK Selected is #{METAL_LEVEL}")

# POLY_RES
POLY_RES = $poly_res || '1k'

logger.info("POLY_RES Selected is #{POLY_RES}")

# MIM
MIM_OPTION = $mim_option || 'B'

logger.info("MIM Option selected: #{MIM_OPTION}")

# MIM
MIM_CAP = $mim_cap || '2'

logger.info("MIM CAP selected: #{MIM_CAP}")

#================================================
# --------------- CUSTOM CLASSES ----------------
#================================================

# %include rule_decks/custom_classes.lvs

# Instantiate a reader using the new delegate
reader = RBA::NetlistSpiceReader.new(SubcircuitModelsReader.new)

#=== GET NETLIST ===
if $schematic
  $schematic = File.expand_path($schematic)
else
  exts = %w[spice cdl]
  candidates = exts.map { |ext| "#{source.cell_name}.#{ext}" }
  netlists = candidates.select { |f| File.exist?(f) }
  error("Netlist not found, tried: #{candidates}") if netlists.empty?
end

logger.info("Input schematic file: #{$schematic}")

if SCHEMATIC_TRANSLATE
  python_script = File.join(File.dirname(__FILE__), 'gf180_xschem_klayout_spice_convert.py')
  translated_schematic_filename = "#{File.basename($schematic).sub(File.extname($schematic), '')}_translated.spice"
  translated_schematic_path = File.join(Dir.mktmpdir, translated_schematic_filename)
  cmd = "python3 #{python_script} #{$schematic} -o #{translated_schematic_path}"
  logger.info("Running #{cmd}")
  output = `#{cmd}`
  exitstatus = $CHILD_STATUS.exitstatus
  logger.info(output) unless output.empty?

  raise "Script returned a non-zero exit status (#{exitstatus})" unless exitstatus.zero?

  $schematic = translated_schematic_path
end

schematic($schematic, reader)

#================================================
#------------- LAYERS DEFINITIONS ---------------
#================================================

# %include rule_decks/layers_definitions.lvs

#================================================================
#------------------------- MAIN RUNSET --------------------------
#================================================================

logger.info('Starting GF180MCU LVS runset')

#================================================
#------------- LAYERS DERIVATIONS ---------------
#================================================

logger.info('Starting base layers derivations')

#==================================
# ------ GENERAL DERIVATIONS ------
#==================================

# %include rule_decks/general_derivations.lvs

#==================================
# ------ MOSFET DERIVATIONS -------
#==================================

# %include rule_decks/mos_derivations.lvs

#================================
# ------ BJT DERIVATIONS --------
#================================

# %include rule_decks/bjt_derivations.lvs

#================================
# ----- DIODE DERIVATIONS -------
#================================

# Done in diode extraction (avoids spreading logic over multiple files)

#================================
# ---- RESISTOR DERIVATIONS -----
#================================

# %include rule_decks/res_derivations.lvs

#==================================
# ------ MIMCAP DERIVATIONS -------
#==================================

# %include rule_decks/mimcap_derivations.lvs

#==================================
# ------ MOSCAP DERIVATIONS -------
#==================================

# %include rule_decks/moscap_derivations.lvs

#================================
# ---- MOS-SAB DERIVATIONS ------
#================================

# %include rule_decks/mos_sab_derivations.lvs

#================================
# ----- EFUSE DERIVATIONS -------
#================================

# %include rule_decks/efuse_derivations.lvs

#================================================================
#------------- [PEX] SAVE LAYER NAMES ---------------------------
#================================================================
# NOTE: Names must be assigned before the layers are used for the first time
#       in connect, soft_connect, connect_global, soft_connect_global
#       and extract_devices statements.

# %include rule_decks/auto_name_layers.rb
auto_name_layers!(binding)

#================================================
#------------ DEVICES CONNECTIVITY --------------
#================================================

# %include rule_decks/devices_connections.lvs

#================================================
#------------- DEVICES EXTRACTION ---------------
#================================================

logger.info('Starting GF180 LVS DEVICES EXTRACTION')

#================================
# ----- MOSFET EXTRACTION -------
#================================

# %include rule_decks/mos_extraction.lvs

#================================
# ------- BJT EXTRACTION --------
#================================

# %include rule_decks/bjt_extraction.lvs

#================================
# ------ DIODE EXTRACTION -------
#================================

# %include rule_decks/diode_extraction.lvs

#================================
# ---- RESISTOR EXTRACTIONS -----
#================================

# %include rule_decks/res_extraction.lvs

#==================================
# ------- MIMCAP EXTRACTION -------
#==================================

# %include rule_decks/mimcap_extraction.lvs

#==================================
# ------- MOSCAP EXTRACTION -------
#==================================

# %include rule_decks/moscap_extraction.lvs

#================================
# ----- MOS-SAB EXTRACTION ------
#================================

# %include rule_decks/mos_sab_extraction.lvs

#================================
# ------ EFUSE EXTRACTIONS ------
#================================

# %include rule_decks/efuse_extraction.lvs

# %include rule_decks/substrate_connections.lvs

#================================================
#------------- COMPARISON OPTIONS ---------------
#================================================

## IMPLICIT_CONNECT
connect_implicit('*') if IMPLICIT_CONNECT

logger.info('Starting GF180 LVS comparison section')

#=== FLATTEN CELLS ===
align

## TOP_LVL_PINS
netlist.make_top_level_pins if TOP_LVL_PINS
schematic.make_top_level_pins if TOP_LVL_PINS

## SIMPLIFY
netlist.simplify if SIMPLIFY
schematic.simplify if SIMPLIFY

## COMBINE_DEVICE
netlist.combine_devices if COMBINE
schematic.combine_devices if COMBINE

## PURGE_NETS
netlist.purge_nets if PURGE_NETS
schematic.purge_nets if PURGE_NETS

## PURGE
netlist.purge if PURGE
schematic.purge if PURGE

#=== NETLIST OPTIONS ===
netlist if NET_ONLY
return if NET_ONLY

#=== IGNORE EXTREME VALUES ===
max_res(1e7)
min_caps(1e-16)

result = compare

result &= flag_missing_ports if CHECK_PORTS

exec_end_time = Time.now
run_time = exec_end_time - exec_start_time
logger.info(format('LVS Total Run time %f seconds', run_time))

if result
  logger.info('==========================================')
  logger.info('INFO : Congratulations! Netlists match.')
  logger.info('==========================================')
else
  logger.info('xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx')
  logger.error("ERROR : Netlists don't match")
  logger.info('xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx')
end
