(sub_iso, sub_regular) = sub.andnot(isosub)
connect(sub, sub_iso)
connect(sub, sub_regular)
connect(sub_iso, isosub)
connect_global(sub_regular, 'SUB')

(ptap_iso, ptap_regular) = ptap.andnot(isosub)
connect(ptap, ptap_iso)
connect(ptap, ptap_regular)
connect(ptap_iso, isosub)
connect_global(ptap_regular, 'SUB')
