# Workaround for hierarchical layer creation, see
# https://github.com/KLayout/klayout/issues/2345
# rubocop:disable Style/GlobalVars
deep if ($run_mode == 'tiling') || ($run_mode == 'flat')

# Any layer would do, as long as they are hierarchical
tmp = polygons(23, 5)

sub = tmp - tmp

case $run_mode
when 'tiling'
  tiles(500.um)
  tile_borders(10.um)
when 'flat'
  flat
end
# rubocop:enable Style/GlobalVars

