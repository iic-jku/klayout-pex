s import DiagnosticsReport\n\nclass Importer:\n    \"\"\"Read PEX25D text split over named supporting files and the primary input.\"\"\"\n\n    def import_file(self, input_file_path: str, *,\n                    supporting_files: Optional[Mapping[str, str]] = None,\n                    options: Optional[Mapping[str, Any]] = None,\n                    report: Optional[DiagnosticsReport] = None) -> PEX25DFile:\n        from klayout_pex import pex25d\n        text = ''.join(Path(path).read_text(encoding='utf-8')\n                       for _, path in sorted((supporting_files or {}).items()))\n        text += Path(input_file_path).read_text(encoding='utf-8')\n        return pex25d.read_text(text.encode('utf-8'), report=report)\n\ndef create_importer() -> Importer:\n    return Importer()\n'"}],"links":[],"hidden":false,"retry":false,"extra":{"severity":"normal","retries":[{"uid":"956883d2ee679636","status":"passed","time":{"start":1793213074612,"stop":1793213074632,"duration":20}},{"uid":"6dd43bd75d30e657","status":"passed","time":{"start":1793213005691,"stop":1793213005702,"duration":11}}],"categories":[],"history":{"statistic":{"failed":0,"broken":0,"skipped":0,"passed":5,"unknown":0,"total":5},"items":[{"uid":"2c4cab9976bd6494","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/889/#testresult/2c4cab9976bd6494","status":"passed","time":{"start":1793212846879,"stop":1793212846892,"duration":13}},{"uid":"eb622bb4ec3959f2","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/888/#testresult/eb622bb4ec3959f2","status":"passed","time":{"start":1793206540977,"stop":1793206540997,"duration":20}},{"uid":"f242a61fc5ba6635","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/882/#testresult/f242a61fc5ba6635","status":"passed","time":{"start":1793199889607,"stop":1793199889624,"duration":17}},{"uid":"dcaee31f54899ae4","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/881/#testresult/dcaee31f54899ae4","status":"passed","time":{"start":1793198995016,"stop