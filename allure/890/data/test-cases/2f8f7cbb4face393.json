gnostics import DiagnosticsReport\n\nclass Importer:\n    \"\"\"Read PEX25D text split over named supporting files and the primary input.\"\"\"\n\n    def import_file(self, input_file_path: str, *,\n                    supporting_files: Optional[Mapping[str, str]] = None,\n                    options: Optional[Mapping[str, Any]] = None,\n                    report: Optional[DiagnosticsReport] = None) -> PEX25DFile:\n        from klayout_pex.plugin_api.v1 import ImporterError\n        raise ImporterError('unsupported construct')\n        text = ''.join(Path(path).read_text(encoding='utf-8')\n                       for _, path in sorted((supporting_files or {}).items()))\n        text += Path(input_file_path).read_text(encoding='utf-8')\n        return pex25d.read_text(text.encode('utf-8'), report=report)\n\ndef create_importer() -> Importer:\n    return Importer()\n'"}],"links":[],"hidden":false,"retry":false,"extra":{"severity":"normal","retries":[{"uid":"5d2f180d613910f4","status":"passed","time":{"start":1793213074693,"stop":1793213074721,"duration":28}},{"uid":"b65b5fb286cc9263","status":"passed","time":{"start":1793213005729,"stop":1793213005744,"duration":15}}],"categories":[],"history":{"statistic":{"failed":0,"broken":0,"skipped":0,"passed":5,"unknown":0,"total":5},"items":[{"uid":"f903edb41a1631c4","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/889/#testresult/f903edb41a1631c4","status":"passed","time":{"start":1793212847031,"stop":1793212847054,"duration":23}},{"uid":"8696f66954454360","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/888/#testresult/8696f66954454360","status":"passed","time":{"start":1793206541058,"stop":1793206541090,"duration":32}},{"uid":"68bc5f9dd6fcf931","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/882/#testresult/68bc5f9dd6fcf931","status":"passed","time":{"start":1793199889678,"stop":1793199889706,"duration":28}},{"uid":"b3cfd30895e96dac","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/881/#