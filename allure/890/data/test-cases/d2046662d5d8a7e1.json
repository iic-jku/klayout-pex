cs import DiagnosticsReport\n\nclass Importer:\n    \"\"\"Read PEX25D text split over named supporting files and the primary input.\"\"\"\n\n    def import_file(self, input_file_path: str, *,\n                    supporting_files: Optional[Mapping[str, str]] = None,\n                    options: Optional[Mapping[str, Any]] = None,\n                    report: Optional[DiagnosticsReport] = None) -> PEX25DFile:\n        open(input_file_path + '.missing')\n        text = ''.join(Path(path).read_text(encoding='utf-8')\n                       for _, path in sorted((supporting_files or {}).items()))\n        text += Path(input_file_path).read_text(encoding='utf-8')\n        return pex25d.read_text(text.encode('utf-8'), report=report)\n\ndef create_importer() -> Importer:\n    return Importer()\n'"}],"links":[],"hidden":false,"retry":false,"extra":{"severity":"normal","retries":[{"uid":"3bb1346ea3d37b79","status":"passed","time":{"start":1793213074737,"stop":1793213074767,"duration":30}},{"uid":"f250a954fab59a35","status":"passed","time":{"start":1793213005750,"stop":1793213005765,"duration":15}}],"categories":[],"history":{"statistic":{"failed":0,"broken":0,"skipped":0,"passed":5,"unknown":0,"total":5},"items":[{"uid":"7710fd12980f1a02","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/889/#testresult/7710fd12980f1a02","status":"passed","time":{"start":1793212847065,"stop":1793212847086,"duration":21}},{"uid":"f9f3fd5e467e08ef","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/888/#testresult/f9f3fd5e467e08ef","status":"passed","time":{"start":1793206541103,"stop":1793206541137,"duration":34}},{"uid":"f61569c8c47bf948","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/882/#testresult/f61569c8c47bf948","status":"passed","time":{"start":1793199889720,"stop":1793199889747,"duration":27}},{"uid":"b7b0ef7443b59d5a","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/881/#testresult/b7b0ef7443b59d5a","status":"passed","time":{"start":1793198995085,