xt split over named supporting files and the primary input.\"\"\"\n\n    def import_file(self, input_file_path: str, *,\n                    supporting_files: Optional[Mapping[str, str]] = None,\n                    options: Optional[Mapping[str, Any]] = None,\n                    report: Optional[DiagnosticsReport] = None) -> PEX25DFile:\n        from kpex import pex25d\n        text = ''.join(Path(path).read_text(encoding='utf-8')\n                       for _, path in sorted((supporting_files or {}).items()))\n        text += Path(input_file_path).read_text(encoding='utf-8')\n        return pex25d.read_text(text.encode('utf-8'), report=report)\n\ndef create_importer() -> Importer:\n    return Importer()\n'"}],"links":[],"hidden":false,"retry":false,"extra":{"severity":"normal","retries":[{"uid":"deab1e9e69efe3b6","status":"passed","time":{"start":1795626852310,"stop":1795626852321,"duration":11}},{"uid":"9759cd9fa2c2d85b","status":"passed","time":{"start":1795626479133,"stop":1795626479141,"duration":8}}],"categories":[],"history":{"statistic":{"failed":0,"broken":0,"skipped":0,"passed":6,"unknown":0,"total":6},"items":[{"uid":"bcf12bfd50924683","reportUrl":"https://iic-jku.github.io/kpex/allure/1253/#testresult/bcf12bfd50924683","status":"passed","time":{"start":1795574624408,"stop":1795574624424,"duration":16}},{"uid":"217cbf7365b48496","reportUrl":"https://iic-jku.github.io/kpex/allure/1252/#testresult/217cbf7365b48496","status":"passed","time":{"start":1795554109009,"stop":1795554109029,"duration":20}},{"uid":"acdd20ba13668fa2","reportUrl":"https://iic-jku.github.io/kpex/allure/1252/#testresult/acdd20ba13668fa2","status":"passed","time":{"start":1795551406253,"stop":1795551406273,"duration":20}},{"uid":"9f3d91a99faddf08","reportUrl":"https://iic-jku.github.io/kpex/allure/1252/#testresult/9f3d91a99faddf08","status":"passed","time":{"start":1795551406253,"stop":1795551406273,"duration":20}},{"uid":"10ee3bd7e59f063d","reportUrl":"https://iic-jku.github.io/kpex/a