nostics import DiagnosticsReport\n\nclass Importer:\n    \"\"\"Read PEX25D text split over named supporting files and the primary input.\"\"\"\n\n    def import_file(self, input_file_path: str, *,\n                    supporting_files: Optional[Mapping[str, str]] = None,\n                    options: Optional[Mapping[str, Any]] = None,\n                    report: Optional[DiagnosticsReport] = None) -> PEX25DFile:\n        from klayout_pex.plugin_api.v1 import ImporterError\n        raise ImporterError('unsupported construct')\n        text = ''.join(Path(path).read_text(encoding='utf-8')\n                       for _, path in sorted((supporting_files or {}).items()))\n        text += Path(input_file_path).read_text(encoding='utf-8')\n        return pex25d.read_text(text.encode('utf-8'), report=report)\n\ndef create_importer() -> Importer:\n    return Importer()\n'"}],"links":[],"hidden":false,"retry":false,"extra":{"severity":"normal","retries":[{"uid":"ca62e512be5d309c","status":"passed","time":{"start":1793982067802,"stop":1793982067826,"duration":24}},{"uid":"8ba1d339ca93598e","status":"passed","time":{"start":1793982023779,"stop":1793982023861,"duration":82}}],"categories":[],"history":{"statistic":{"failed":0,"broken":0,"skipped":0,"passed":87,"unknown":0,"total":87},"items":[{"uid":"7914596cc86cf648","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/1021/#testresult/7914596cc86cf648","status":"passed","time":{"start":1793981489399,"stop":1793981489422,"duration":23}},{"uid":"187d4ed2132cba2a","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/1019/#testresult/187d4ed2132cba2a","status":"passed","time":{"start":1793981167304,"stop":1793981167323,"duration":19}},{"uid":"7d7332a7c1e1848a","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/1014/#testresult/7d7332a7c1e1848a","status":"passed","time":{"start":1793980554887,"stop":1793980554906,"duration":19}},{"uid":"a45ac28ff70fc94b","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/1