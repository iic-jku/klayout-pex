 DiagnosticsReport\n\nclass Importer:\n    \"\"\"Read PEX25D text split over named supporting files and the primary input.\"\"\"\n\n    def import_file(self, input_file_path: str, *,\n                    supporting_files: Optional[Mapping[str, str]] = None,\n                    options: Optional[Mapping[str, Any]] = None,\n                    report: Optional[DiagnosticsReport] = None) -> PEX25DFile:\n        from kpex.plugin_api.v1 import ImporterError\n        raise ImporterError('unsupported construct')\n        text = ''.join(Path(path).read_text(encoding='utf-8')\n                       for _, path in sorted((supporting_files or {}).items()))\n        text += Path(input_file_path).read_text(encoding='utf-8')\n        return pex25d.read_text(text.encode('utf-8'), report=report)\n\ndef create_importer() -> Importer:\n    return Importer()\n'"}],"links":[],"hidden":false,"retry":false,"extra":{"severity":"normal","retries":[{"uid":"b09153b11db01a7d","status":"passed","time":{"start":1795551406345,"stop":1795551406377,"duration":32}},{"uid":"209123cdece79cf2","status":"passed","time":{"start":1795550825964,"stop":1795550825977,"duration":13}}],"categories":[],"history":{"statistic":{"failed":0,"broken":0,"skipped":0,"passed":4,"unknown":0,"total":4},"items":[{"uid":"fba0fa51c4d9e2bb","reportUrl":"https://iic-jku.github.io/kpex/allure/1252/#testresult/fba0fa51c4d9e2bb","status":"passed","time":{"start":1795551406345,"stop":1795551406377,"duration":32}},{"uid":"399e9e91f3d14d60","reportUrl":"https://iic-jku.github.io/kpex/allure/1252/#testresult/399e9e91f3d14d60","status":"passed","time":{"start":1795551406345,"stop":1795551406377,"duration":32}},{"uid":"338206d6b8332564","reportUrl":"https://iic-jku.github.io/kpex/allure/1249/#testresult/338206d6b8332564","status":"passed","time":{"start":1795544128501,"stop":1795544128520,"duration":19}}]},"tags":[]},"source":"74753f277a9c817a.json","parameterValues":["'example'","'\nfrom __future__ import annotations\n\nfrom pathlib import Path\nfrom typing import TYPE_CHECKING, Any, Mapping, Optional\n\nif TYPE_CHECKING:\n    from kpex_protobuf.kpex.pex25d.pex25d_file_pb2 import PEX25DFile\n\n    from kpex.pex25d.diagnostics import DiagnosticsReport\n\nclass Importer:\n    \"\"\"Read PEX25D text split over named supporting files and the primary input.\"\"\"\n\n    def import_file(self, input_file_path: str, *,\n                    supporting_files: Optional[Mapping[str, str]] = None,\n                    options: Optional[Mapping[str, Any]] = None,\n                    report: Optional[DiagnosticsReport] = None) -> PEX25DFile:\n        from kpex.plugin_api.v1 import ImporterError\n        raise ImporterError('unsupported construct')\n        text = ''.join(Path(path).read_text(encoding='utf-8')\n                       for _, path in sorted((supporting_files or {}).items()))\n        text += Path(input_file_path).read_text(encoding='utf-8')\n        return pex25d.read_text(text.encode('utf-8'), report=report)\n\ndef create_importer() -> Importer:\n    return Importer()\n'"]}