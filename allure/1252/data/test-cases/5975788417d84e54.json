ticsReport\n\nclass Importer:\n    \"\"\"Read PEX25D text split over named supporting files and the primary input.\"\"\"\n\n    def import_file(self, input_file_path: str, *,\n                    supporting_files: Optional[Mapping[str, str]] = None,\n                    options: Optional[Mapping[str, Any]] = None,\n                    report: Optional[DiagnosticsReport] = None) -> PEX25DFile:\n        open(input_file_path + '.missing')\n        text = ''.join(Path(path).read_text(encoding='utf-8')\n                       for _, path in sorted((supporting_files or {}).items()))\n        text += Path(input_file_path).read_text(encoding='utf-8')\n        return pex25d.read_text(text.encode('utf-8'), report=report)\n\ndef create_importer() -> Importer:\n    return Importer()\n'"}],"links":[],"hidden":false,"retry":false,"extra":{"severity":"normal","retries":[{"uid":"b7db6460239006f7","status":"passed","time":{"start":1795551406395,"stop":1795551406426,"duration":31}},{"uid":"4759aa7d12e8f1cf","status":"passed","time":{"start":1795550825983,"stop":1795550825995,"duration":12}}],"categories":[],"history":{"statistic":{"failed":0,"broken":0,"skipped":0,"passed":4,"unknown":0,"total":4},"items":[{"uid":"a783fcdf420c4708","reportUrl":"https://iic-jku.github.io/kpex/allure/1252/#testresult/a783fcdf420c4708","status":"passed","time":{"start":1795551406395,"stop":1795551406426,"duration":31}},{"uid":"a3d646a89e999fc4","reportUrl":"https://iic-jku.github.io/kpex/allure/1252/#testresult/a3d646a89e999fc4","status":"passed","time":{"start":1795551406395,"stop":1795551406426,"duration":31}},{"uid":"b7fbab9896f2007e","reportUrl":"https://iic-jku.github.io/kpex/allure/1249/#testresult/b7fbab9896f2007e","status":"passed","time":{"start":1795544128529,"stop":1795544128548,"duration":19}}]},"tags":[]},"source":"5975788417d84e54.json","parameterValues":["'example'","'\nfrom __future__ import annotations\n\nfrom pathlib import Path\nfrom typing import TYPE_CHECKING, Any, Mapping, Optional\n\nif TYPE_CHECKING:\n    from kpex_protobuf.kpex.pex25d.pex25d_file_pb2 import PEX25DFile\n\n    from kpex.pex25d.diagnostics import DiagnosticsReport\n\nclass Importer:\n    \"\"\"Read PEX25D text split over named supporting files and the primary input.\"\"\"\n\n    def import_file(self, input_file_path: str, *,\n                    supporting_files: Optional[Mapping[str, str]] = None,\n                    options: Optional[Mapping[str, Any]] = None,\n                    report: Optional[DiagnosticsReport] = None) -> PEX25DFile:\n        open(input_file_path + '.missing')\n        text = ''.join(Path(path).read_text(encoding='utf-8')\n                       for _, path in sorted((supporting_files or {}).items()))\n        text += Path(input_file_path).read_text(encoding='utf-8')\n        return pex25d.read_text(text.encode('utf-8'), report=report)\n\ndef create_importer() -> Importer:\n    return Importer()\n'"]}