   \"\"\"Read PEX25D text split over named supporting files and the primary input.\"\"\"\n\n    def import_file(self, input_file_path: str, *,\n                    supporting_files: Optional[Mapping[str, str]] = None,\n                    options: Optional[Mapping[str, Any]] = None,\n                    report: Optional[DiagnosticsReport] = None) -> PEX25DFile:\n        from klayout_pex.plugin_api.v1 import ImporterError\n        raise ImporterError('unsupported construct')\n        text = ''.join(Path(path).read_text(encoding='utf-8')\n                       for _, path in sorted((supporting_files or {}).items()))\n        text += Path(input_file_path).read_text(encoding='utf-8')\n        return pex25d.read_text(text.encode('utf-8'), report=report)\n\ndef create_importer() -> Importer:\n    return Importer()\n'"}],"links":[],"hidden":false,"retry":false,"extra":{"severity":"normal","retries":[{"uid":"fed38130c3a3e710","status":"passed","time":{"start":1793357261056,"stop":1793357261079,"duration":23}},{"uid":"f9ac8c4cdd8d084a","status":"passed","time":{"start":1793357198595,"stop":1793357198608,"duration":13}}],"categories":[],"history":{"statistic":{"failed":0,"broken":0,"skipped":0,"passed":14,"unknown":0,"total":14},"items":[{"uid":"3e569feb690d03e1","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/902/#testresult/3e569feb690d03e1","status":"passed","time":{"start":1793286825366,"stop":1793286825395,"duration":29}},{"uid":"872ae1529addea82","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/901/#testresult/872ae1529addea82","status":"passed","time":{"start":1793286210960,"stop":1793286210973,"duration":13}},{"uid":"c6140fdfc492ab6e","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/900/#testresult/c6140fdfc492ab6e","status":"passed","time":{"start":1793278795943,"stop":1793278795961,"duration":18}},{"uid":"fcceddcacf6b7525","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/899/#testresult/fcceddcacf6b7525","status":"passed","time"