cs import DiagnosticsReport\n\nclass Importer:\n    \"\"\"Read PEX25D text split over named supporting files and the primary input.\"\"\"\n\n    def import_file(self, input_file_path: str, *,\n                    supporting_files: Optional[Mapping[str, str]] = None,\n                    options: Optional[Mapping[str, Any]] = None,\n                    report: Optional[DiagnosticsReport] = None) -> PEX25DFile:\n        open(input_file_path + '.missing')\n        text = ''.join(Path(path).read_text(encoding='utf-8')\n                       for _, path in sorted((supporting_files or {}).items()))\n        text += Path(input_file_path).read_text(encoding='utf-8')\n        return pex25d.read_text(text.encode('utf-8'), report=report)\n\ndef create_importer() -> Importer:\n    return Importer()\n'"}],"links":[],"hidden":false,"retry":false,"extra":{"severity":"normal","retries":[{"uid":"4efc701e6942a053","status":"passed","time":{"start":1793214432827,"stop":1793214432857,"duration":30}},{"uid":"6c8bb3eee9c64790","status":"passed","time":{"start":1793214364717,"stop":1793214364739,"duration":22}}],"categories":[],"history":{"statistic":{"failed":0,"broken":0,"skipped":0,"passed":7,"unknown":0,"total":7},"items":[{"uid":"2d17116707743155","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/892/#testresult/2d17116707743155","status":"passed","time":{"start":1793214409738,"stop":1793214409771,"duration":33}},{"uid":"d2046662d5d8a7e1","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/890/#testresult/d2046662d5d8a7e1","status":"passed","time":{"start":1793213323008,"stop":1793213323027,"duration":19}},{"uid":"7710fd12980f1a02","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/889/#testresult/7710fd12980f1a02","status":"passed","time":{"start":1793212847065,"stop":1793212847086,"duration":21}},{"uid":"f9f3fd5e467e08ef","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/888/#testresult/f9f3fd5e467e08ef","status":"passed","time":{"start":1793206541103,