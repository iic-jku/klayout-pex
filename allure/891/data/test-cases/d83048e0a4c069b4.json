s import DiagnosticsReport\n\nclass Importer:\n    \"\"\"Read PEX25D text split over named supporting files and the primary input.\"\"\"\n\n    def import_file(self, input_file_path: str, *,\n                    supporting_files: Optional[Mapping[str, str]] = None,\n                    options: Optional[Mapping[str, Any]] = None,\n                    report: Optional[DiagnosticsReport] = None) -> PEX25DFile:\n        from klayout_pex import pex25d\n        text = ''.join(Path(path).read_text(encoding='utf-8')\n                       for _, path in sorted((supporting_files or {}).items()))\n        text += Path(input_file_path).read_text(encoding='utf-8')\n        return pex25d.read_text(text.encode('utf-8'), report=report)\n\ndef create_importer() -> Importer:\n    return Importer()\n'"}],"links":[],"hidden":false,"retry":false,"extra":{"severity":"normal","retries":[{"uid":"9b090cf216f5c710","status":"passed","time":{"start":1793214432706,"stop":1793214432725,"duration":19}},{"uid":"718c7322740f2e7d","status":"passed","time":{"start":1793214364627,"stop":1793214364643,"duration":16}}],"categories":[],"history":{"statistic":{"failed":0,"broken":0,"skipped":0,"passed":7,"unknown":0,"total":7},"items":[{"uid":"943af05516a3f62a","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/892/#testresult/943af05516a3f62a","status":"passed","time":{"start":1793214409611,"stop":1793214409630,"duration":19}},{"uid":"2445a825f2b6e7ac","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/890/#testresult/2445a825f2b6e7ac","status":"passed","time":{"start":1793213322936,"stop":1793213322947,"duration":11}},{"uid":"2c4cab9976bd6494","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/889/#testresult/2c4cab9976bd6494","status":"passed","time":{"start":1793212846879,"stop":1793212846892,"duration":13}},{"uid":"eb622bb4ec3959f2","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/888/#testresult/eb622bb4ec3959f2","status":"passed","time":{"start":1793206540977,"stop