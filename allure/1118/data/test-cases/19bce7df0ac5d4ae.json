nostics import DiagnosticsReport\n\nclass Importer:\n    \"\"\"Read PEX25D text split over named supporting files and the primary input.\"\"\"\n\n    def import_file(self, input_file_path: str, *,\n                    supporting_files: Optional[Mapping[str, str]] = None,\n                    options: Optional[Mapping[str, Any]] = None,\n                    report: Optional[DiagnosticsReport] = None) -> PEX25DFile:\n        from klayout_pex.plugin_api.v1 import ImporterError\n        raise ImporterError('unsupported construct')\n        text = ''.join(Path(path).read_text(encoding='utf-8')\n                       for _, path in sorted((supporting_files or {}).items()))\n        text += Path(input_file_path).read_text(encoding='utf-8')\n        return pex25d.read_text(text.encode('utf-8'), report=report)\n\ndef create_importer() -> Importer:\n    return Importer()\n'"}],"links":[],"hidden":false,"retry":false,"extra":{"severity":"normal","retries":[{"uid":"60d2a584d3a9791a","status":"passed","time":{"start":1794325637381,"stop":1794325637407,"duration":26}},{"uid":"ff76f779694ebc05","status":"passed","time":{"start":1794325589780,"stop":1794325589800,"duration":20}}],"categories":[],"history":{"statistic":{"failed":0,"broken":0,"skipped":0,"passed":150,"unknown":0,"total":150},"items":[{"uid":"c952be4f5f64f699","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/1117/#testresult/c952be4f5f64f699","status":"passed","time":{"start":1794325726054,"stop":1794325726067,"duration":13}},{"uid":"ad5997d307b84fcb","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/1116/#testresult/ad5997d307b84fcb","status":"passed","time":{"start":1794321848706,"stop":1794321848736,"duration":30}},{"uid":"9c50993a1ec2170","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/1114/#testresult/9c50993a1ec2170","status":"passed","time":{"start":1794321612119,"stop":1794321612144,"duration":25}},{"uid":"5e971c08b1e2e2f6","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/1