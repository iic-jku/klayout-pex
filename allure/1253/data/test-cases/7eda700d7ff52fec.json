PEX25D text split over named supporting files and the primary input.\"\"\"\n\n    def import_file(self, input_file_path: str, *,\n                    supporting_files: Optional[Mapping[str, str]] = None,\n                    options: Optional[Mapping[str, Any]] = None,\n                    report: Optional[DiagnosticsReport] = None) -> PEX25DFile:\n        from kpex.plugin_api.v1 import ImporterError\n        raise ImporterError('unsupported construct')\n        text = ''.join(Path(path).read_text(encoding='utf-8')\n                       for _, path in sorted((supporting_files or {}).items()))\n        text += Path(input_file_path).read_text(encoding='utf-8')\n        return pex25d.read_text(text.encode('utf-8'), report=report)\n\ndef create_importer() -> Importer:\n    return Importer()\n'"}],"links":[],"hidden":false,"retry":false,"extra":{"severity":"normal","retries":[{"uid":"737675e0bc725d76","status":"passed","time":{"start":1795574190990,"stop":1795574191007,"duration":17}},{"uid":"c2f3202a1eab0092","status":"passed","time":{"start":1795574052440,"stop":1795574052457,"duration":17}}],"categories":[],"history":{"statistic":{"failed":0,"broken":0,"skipped":0,"passed":5,"unknown":0,"total":5},"items":[{"uid":"74753f277a9c817a","reportUrl":"https://iic-jku.github.io/kpex/allure/1252/#testresult/74753f277a9c817a","status":"passed","time":{"start":1795554109068,"stop":1795554109086,"duration":18}},{"uid":"fba0fa51c4d9e2bb","reportUrl":"https://iic-jku.github.io/kpex/allure/1252/#testresult/fba0fa51c4d9e2bb","status":"passed","time":{"start":1795551406345,"stop":1795551406377,"duration":32}},{"uid":"399e9e91f3d14d60","reportUrl":"https://iic-jku.github.io/kpex/allure/1252/#testresult/399e9e91f3d14d60","status":"passed","time":{"start":1795551406345,"stop":1795551406377,"duration":32}},{"uid":"338206d6b8332564","reportUrl":"https://iic-jku.github.io/kpex/allure/1249/#testresult/338206d6b8332564","status":"passed","time":{"start":1795544128501,"stop":1795544128520,"d