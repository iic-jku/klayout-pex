nostics import DiagnosticsReport\n\nclass Importer:\n    \"\"\"Read PEX25D text split over named supporting files and the primary input.\"\"\"\n\n    def import_file(self, input_file_path: str, *,\n                    supporting_files: Optional[Mapping[str, str]] = None,\n                    options: Optional[Mapping[str, Any]] = None,\n                    report: Optional[DiagnosticsReport] = None) -> PEX25DFile:\n        from klayout_pex.plugin_api.v1 import ImporterError\n        raise ImporterError('unsupported construct')\n        text = ''.join(Path(path).read_text(encoding='utf-8')\n                       for _, path in sorted((supporting_files or {}).items()))\n        text += Path(input_file_path).read_text(encoding='utf-8')\n        return pex25d.read_text(text.encode('utf-8'), report=report)\n\ndef create_importer() -> Importer:\n    return Importer()\n'"}],"links":[],"hidden":false,"retry":false,"extra":{"severity":"normal","retries":[{"uid":"9f1d84bacad582dc","status":"passed","time":{"start":1794867885688,"stop":1794867885703,"duration":15}},{"uid":"6895a11a53747d3","status":"passed","time":{"start":1794867691116,"stop":1794867691138,"duration":22}}],"categories":[],"history":{"statistic":{"failed":0,"broken":0,"skipped":0,"passed":214,"unknown":0,"total":214},"items":[{"uid":"84b37b9f39e08aa8","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/1194/#testresult/84b37b9f39e08aa8","status":"passed","time":{"start":1794868542453,"stop":1794868542475,"duration":22}},{"uid":"21b4c88cba75c720","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/1196/#testresult/21b4c88cba75c720","status":"passed","time":{"start":1794868229459,"stop":1794868229473,"duration":14}},{"uid":"4f4b8e266caf5b62","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/1192/#testresult/4f4b8e266caf5b62","status":"passed","time":{"start":1794866762005,"stop":1794866762040,"duration":35}},{"uid":"49d781b8e86a4f0e","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/