nostics import DiagnosticsReport\n\nclass Importer:\n    \"\"\"Read PEX25D text split over named supporting files and the primary input.\"\"\"\n\n    def import_file(self, input_file_path: str, *,\n                    supporting_files: Optional[Mapping[str, str]] = None,\n                    options: Optional[Mapping[str, Any]] = None,\n                    report: Optional[DiagnosticsReport] = None) -> PEX25DFile:\n        from klayout_pex.plugin_api.v1 import ImporterError\n        raise ImporterError('unsupported construct')\n        text = ''.join(Path(path).read_text(encoding='utf-8')\n                       for _, path in sorted((supporting_files or {}).items()))\n        text += Path(input_file_path).read_text(encoding='utf-8')\n        return pex25d.read_text(text.encode('utf-8'), report=report)\n\ndef create_importer() -> Importer:\n    return Importer()\n'"}],"links":[],"hidden":false,"retry":false,"extra":{"severity":"normal","retries":[{"uid":"6e4121496ef06e85","status":"passed","time":{"start":1793902886947,"stop":1793902886966,"duration":19}},{"uid":"19146b079f10a063","status":"passed","time":{"start":1793902857185,"stop":1793902857196,"duration":11}}],"categories":[],"history":{"statistic":{"failed":0,"broken":0,"skipped":0,"passed":54,"unknown":0,"total":54},"items":[{"uid":"dcf999d07c5a7fa5","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/959/#testresult/dcf999d07c5a7fa5","status":"passed","time":{"start":1793900634028,"stop":1793900634040,"duration":12}},{"uid":"40304d85cefe7b16","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/957/#testresult/40304d85cefe7b16","status":"passed","time":{"start":1793900136313,"stop":1793900136333,"duration":20}},{"uid":"a7277acfb728566f","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/956/#testresult/a7277acfb728566f","status":"passed","time":{"start":1793886467500,"stop":1793886467513,"duration":13}},{"uid":"4311c42016d17ea3","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/955/