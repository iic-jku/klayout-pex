PEX25D text split over named supporting files and the primary input.\"\"\"\n\n    def import_file(self, input_file_path: str, *,\n                    supporting_files: Optional[Mapping[str, str]] = None,\n                    options: Optional[Mapping[str, Any]] = None,\n                    report: Optional[DiagnosticsReport] = None) -> PEX25DFile:\n        from kpex.plugin_api.v1 import ImporterError\n        raise ImporterError('unsupported construct')\n        text = ''.join(Path(path).read_text(encoding='utf-8')\n                       for _, path in sorted((supporting_files or {}).items()))\n        text += Path(input_file_path).read_text(encoding='utf-8')\n        return pex25d.read_text(text.encode('utf-8'), report=report)\n\ndef create_importer() -> Importer:\n    return Importer()\n'"}],"links":[],"hidden":false,"retry":false,"extra":{"severity":"normal","retries":[{"uid":"14ee8be9eae66e92","status":"passed","time":{"start":1795752386270,"stop":1795752386292,"duration":22}},{"uid":"6ca7436f8c6e0ae4","status":"passed","time":{"start":1795752298781,"stop":1795752298793,"duration":12}}],"categories":[],"history":{"statistic":{"failed":0,"broken":0,"skipped":0,"passed":11,"unknown":0,"total":11},"items":[{"uid":"61f1dce9465b5221","reportUrl":"https://iic-jku.github.io/kpex/allure/1270/#testresult/61f1dce9465b5221","status":"passed","time":{"start":1795707957040,"stop":1795707957066,"duration":26}},{"uid":"f43247a637151797","reportUrl":"https://iic-jku.github.io/kpex/allure/1267/#testresult/f43247a637151797","status":"passed","time":{"start":1795639165771,"stop":1795639165794,"duration":23}},{"uid":"728e8b5d98a85167","reportUrl":"https://iic-jku.github.io/kpex/allure/1266/#testresult/728e8b5d98a85167","status":"passed","time":{"start":1795638738370,"stop":1795638738404,"duration":34}},{"uid":"69b55804957d80f1","reportUrl":"https://iic-jku.github.io/kpex/allure/1261/#testresult/69b55804957d80f1","status":"passed","time":{"start":1795636165380,"stop":1795636165400,