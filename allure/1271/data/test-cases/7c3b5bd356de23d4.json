 text split over named supporting files and the primary input.\"\"\"\n\n    def import_file(self, input_file_path: str, *,\n                    supporting_files: Optional[Mapping[str, str]] = None,\n                    options: Optional[Mapping[str, Any]] = None,\n                    report: Optional[DiagnosticsReport] = None) -> PEX25DFile:\n        open(input_file_path + '.missing')\n        text = ''.join(Path(path).read_text(encoding='utf-8')\n                       for _, path in sorted((supporting_files or {}).items()))\n        text += Path(input_file_path).read_text(encoding='utf-8')\n        return pex25d.read_text(text.encode('utf-8'), report=report)\n\ndef create_importer() -> Importer:\n    return Importer()\n'"}],"links":[],"hidden":false,"retry":false,"extra":{"severity":"normal","retries":[{"uid":"7ad1ce9847bc0f3b","status":"passed","time":{"start":1795752386301,"stop":1795752386330,"duration":29}},{"uid":"f186ae020a0fca0b","status":"passed","time":{"start":1795752298798,"stop":1795752298811,"duration":13}}],"categories":[],"history":{"statistic":{"failed":0,"broken":0,"skipped":0,"passed":11,"unknown":0,"total":11},"items":[{"uid":"aebd1b3a96f789ee","reportUrl":"https://iic-jku.github.io/kpex/allure/1270/#testresult/aebd1b3a96f789ee","status":"passed","time":{"start":1795707957076,"stop":1795707957099,"duration":23}},{"uid":"91146797c79ef834","reportUrl":"https://iic-jku.github.io/kpex/allure/1267/#testresult/91146797c79ef834","status":"passed","time":{"start":1795639165806,"stop":1795639165829,"duration":23}},{"uid":"7abebb5504ddd75","reportUrl":"https://iic-jku.github.io/kpex/allure/1266/#testresult/7abebb5504ddd75","status":"passed","time":{"start":1795638738421,"stop":1795638738457,"duration":36}},{"uid":"a7ca16876850138d","reportUrl":"https://iic-jku.github.io/kpex/allure/1261/#testresult/a7ca16876850138d","status":"passed","time":{"start":1795636165429,"stop":1795636165456,"duration":27}},{"uid":"a32614a762dcb83a","reportUrl":"https://iic-jku.g