PEX25D text split over named supporting files and the primary input.\"\"\"\n\n    def import_file(self, input_file_path: str, *,\n                    supporting_files: Optional[Mapping[str, str]] = None,\n                    options: Optional[Mapping[str, Any]] = None,\n                    report: Optional[DiagnosticsReport] = None) -> PEX25DFile:\n        from kpex.plugin_api.v1 import ImporterError\n        raise ImporterError('unsupported construct')\n        text = ''.join(Path(path).read_text(encoding='utf-8')\n                       for _, path in sorted((supporting_files or {}).items()))\n        text += Path(input_file_path).read_text(encoding='utf-8')\n        return pex25d.read_text(text.encode('utf-8'), report=report)\n\ndef create_importer() -> Importer:\n    return Importer()\n'"}],"links":[],"hidden":false,"retry":false,"extra":{"severity":"normal","retries":[{"uid":"729cd72b28c6dcb0","status":"passed","time":{"start":1795785586471,"stop":1795785586492,"duration":21}},{"uid":"714564345927f723","status":"passed","time":{"start":1795785489226,"stop":1795785489246,"duration":20}}],"categories":[],"history":{"statistic":{"failed":0,"broken":0,"skipped":0,"passed":18,"unknown":0,"total":18},"items":[{"uid":"b52d2221fadcc62c","reportUrl":"https://iic-jku.github.io/kpex/allure/1282/#testresult/b52d2221fadcc62c","status":"passed","time":{"start":1795782982791,"stop":1795782982820,"duration":29}},{"uid":"c9e84dd4bfef7e0","reportUrl":"https://iic-jku.github.io/kpex/allure/1281/#testresult/c9e84dd4bfef7e0","status":"passed","time":{"start":1795779717647,"stop":1795779717679,"duration":32}},{"uid":"fdace6ee3b1d4aac","reportUrl":"https://iic-jku.github.io/kpex/allure/1276/#testresult/fdace6ee3b1d4aac","status":"passed","time":{"start":1795772415123,"stop":1795772415145,"duration":22}},{"uid":"f17417f0fc7bd1d2","reportUrl":"https://iic-jku.github.io/kpex/allure/1275/#testresult/f17417f0fc7bd1d2","status":"passed","time":{"start":1795772284942,"stop":1795772285145,"d