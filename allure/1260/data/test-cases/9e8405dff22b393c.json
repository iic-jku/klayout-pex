sticsReport\n\nclass Importer:\n    \"\"\"Read PEX25D text split over named supporting files and the primary input.\"\"\"\n\n    def import_file(self, input_file_path: str, *,\n                    supporting_files: Optional[Mapping[str, str]] = None,\n                    options: Optional[Mapping[str, Any]] = None,\n                    report: Optional[DiagnosticsReport] = None) -> PEX25DFile:\n        from kpex import pex25d\n        text = ''.join(Path(path).read_text(encoding='utf-8')\n                       for _, path in sorted((supporting_files or {}).items()))\n        text += Path(input_file_path).read_text(encoding='utf-8')\n        return pex25d.read_text(text.encode('utf-8'), report=report)\n\ndef create_importer() -> Importer:\n    return Importer()\n'"}],"links":[],"hidden":false,"retry":false,"extra":{"severity":"normal","retries":[{"uid":"a16225ea26cda002","status":"passed","time":{"start":1795634655785,"stop":1795634655803,"duration":18}},{"uid":"890827a029289349","status":"passed","time":{"start":1795634559795,"stop":1795634559808,"duration":13}}],"categories":[],"history":{"statistic":{"failed":0,"broken":0,"skipped":0,"passed":7,"unknown":0,"total":7},"items":[{"uid":"5df0707096ee7c97","reportUrl":"https://iic-jku.github.io/kpex/allure/1256/#testresult/5df0707096ee7c97","status":"passed","time":{"start":1795627133768,"stop":1795627133788,"duration":20}},{"uid":"bcf12bfd50924683","reportUrl":"https://iic-jku.github.io/kpex/allure/1253/#testresult/bcf12bfd50924683","status":"passed","time":{"start":1795574624408,"stop":1795574624424,"duration":16}},{"uid":"217cbf7365b48496","reportUrl":"https://iic-jku.github.io/kpex/allure/1252/#testresult/217cbf7365b48496","status":"passed","time":{"start":1795554109009,"stop":1795554109029,"duration":20}},{"uid":"acdd20ba13668fa2","reportUrl":"https://iic-jku.github.io/kpex/allure/1252/#testresult/acdd20ba13668fa2","status":"passed","time":{"start":1795551406253,"stop":1795551406273,"duration":20}},{"uid":"9f3d91