 import DiagnosticsReport\n\nclass Importer:\n    \"\"\"Read PEX25D text split over named supporting files and the primary input.\"\"\"\n\n    def import_file(self, input_file_path: str, *,\n                    supporting_files: Optional[Mapping[str, str]] = None,\n                    options: Optional[Mapping[str, Any]] = None,\n                    report: Optional[DiagnosticsReport] = None) -> PEX25DFile:\n        open(input_file_path + '.missing')\n        text = ''.join(Path(path).read_text(encoding='utf-8')\n                       for _, path in sorted((supporting_files or {}).items()))\n        text += Path(input_file_path).read_text(encoding='utf-8')\n        return pex25d.read_text(text.encode('utf-8'), report=report)\n\ndef create_importer() -> Importer:\n    return Importer()\n'"}],"links":[],"hidden":false,"retry":false,"extra":{"severity":"normal","retries":[{"uid":"617f1cd51b4d5ce2","status":"passed","time":{"start":1794588184041,"stop":1794588184059,"duration":18}},{"uid":"e6932a9a70011d06","status":"passed","time":{"start":1794588153901,"stop":1794588153913,"duration":12}}],"categories":[],"history":{"statistic":{"failed":0,"broken":0,"skipped":0,"passed":187,"unknown":0,"total":187},"items":[{"uid":"fba92862db8bb197","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/1163/#testresult/fba92862db8bb197","status":"passed","time":{"start":1794587704058,"stop":1794587704087,"duration":29}},{"uid":"cdb99acfab41a42c","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/1162/#testresult/cdb99acfab41a42c","status":"passed","time":{"start":1794579136817,"stop":1794579136846,"duration":29}},{"uid":"83a0bed8a5a142c2","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/1161/#testresult/83a0bed8a5a142c2","status":"passed","time":{"start":1794572903123,"stop":1794572903153,"duration":30}},{"uid":"13c318f6ef140b42","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/1160/#testresult/13c318f6ef140b42","status":"passed","time":{"start":17945273