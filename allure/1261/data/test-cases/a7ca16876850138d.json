osticsReport\n\nclass Importer:\n    \"\"\"Read PEX25D text split over named supporting files and the primary input.\"\"\"\n\n    def import_file(self, input_file_path: str, *,\n                    supporting_files: Optional[Mapping[str, str]] = None,\n                    options: Optional[Mapping[str, Any]] = None,\n                    report: Optional[DiagnosticsReport] = None) -> PEX25DFile:\n        open(input_file_path + '.missing')\n        text = ''.join(Path(path).read_text(encoding='utf-8')\n                       for _, path in sorted((supporting_files or {}).items()))\n        text += Path(input_file_path).read_text(encoding='utf-8')\n        return pex25d.read_text(text.encode('utf-8'), report=report)\n\ndef create_importer() -> Importer:\n    return Importer()\n'"}],"links":[],"hidden":false,"retry":false,"extra":{"severity":"normal","retries":[{"uid":"78a2156c111f4fc4","status":"passed","time":{"start":1795635917780,"stop":1795635917807,"duration":27}},{"uid":"e3b6a960dda002a5","status":"passed","time":{"start":1795635861893,"stop":1795635861913,"duration":20}}],"categories":[],"history":{"statistic":{"failed":0,"broken":0,"skipped":0,"passed":7,"unknown":0,"total":7},"items":[{"uid":"a32614a762dcb83a","reportUrl":"https://iic-jku.github.io/kpex/allure/1256/#testresult/a32614a762dcb83a","status":"passed","time":{"start":1795627133899,"stop":1795627133930,"duration":31}},{"uid":"48f6b7b029eebf14","reportUrl":"https://iic-jku.github.io/kpex/allure/1253/#testresult/48f6b7b029eebf14","status":"passed","time":{"start":1795574624505,"stop":1795574624528,"duration":23}},{"uid":"5975788417d84e54","reportUrl":"https://iic-jku.github.io/kpex/allure/1252/#testresult/5975788417d84e54","status":"passed","time":{"start":1795554109096,"stop":1795554109115,"duration":19}},{"uid":"a783fcdf420c4708","reportUrl":"https://iic-jku.github.io/kpex/allure/1252/#testresult/a783fcdf420c4708","status":"passed","time":{"start":1795551406395,"stop":1795551406426,"duration":31}},{"