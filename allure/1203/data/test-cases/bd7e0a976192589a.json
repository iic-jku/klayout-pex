s import DiagnosticsReport\n\nclass Importer:\n    \"\"\"Read PEX25D text split over named supporting files and the primary input.\"\"\"\n\n    def import_file(self, input_file_path: str, *,\n                    supporting_files: Optional[Mapping[str, str]] = None,\n                    options: Optional[Mapping[str, Any]] = None,\n                    report: Optional[DiagnosticsReport] = None) -> PEX25DFile:\n        open(input_file_path + '.missing')\n        text = ''.join(Path(path).read_text(encoding='utf-8')\n                       for _, path in sorted((supporting_files or {}).items()))\n        text += Path(input_file_path).read_text(encoding='utf-8')\n        return pex25d.read_text(text.encode('utf-8'), report=report)\n\ndef create_importer() -> Importer:\n    return Importer()\n'"}],"links":[],"hidden":false,"retry":false,"extra":{"severity":"normal","retries":[{"uid":"fd721c95930b699e","status":"passed","time":{"start":1794947872003,"stop":1794947872035,"duration":32}},{"uid":"bd6cd4e52c4d1d96","status":"passed","time":{"start":1794947552950,"stop":1794947552966,"duration":16}}],"categories":[],"history":{"statistic":{"failed":0,"broken":0,"skipped":0,"passed":220,"unknown":0,"total":220},"items":[{"uid":"753a8e347c25be88","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/1203/#testresult/753a8e347c25be88","status":"passed","time":{"start":1794948051768,"stop":1794948051791,"duration":23}},{"uid":"e7ca0cda1ac3cda2","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/1202/#testresult/e7ca0cda1ac3cda2","status":"passed","time":{"start":1794935337788,"stop":1794935337820,"duration":32}},{"uid":"41ccf72390f8a9a7","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/1200/#testresult/41ccf72390f8a9a7","status":"passed","time":{"start":1794873616724,"stop":1794873616740,"duration":16}},{"uid":"d01e8c0a3f441e11","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/1198/#testresult/d01e8c0a3f441e11","status":"passed","time":{"start":1794871