nostics import DiagnosticsReport\n\nclass Importer:\n    \"\"\"Read PEX25D text split over named supporting files and the primary input.\"\"\"\n\n    def import_file(self, input_file_path: str, *,\n                    supporting_files: Optional[Mapping[str, str]] = None,\n                    options: Optional[Mapping[str, Any]] = None,\n                    report: Optional[DiagnosticsReport] = None) -> PEX25DFile:\n        from klayout_pex.plugin_api.v1 import ImporterError\n        raise ImporterError('unsupported construct')\n        text = ''.join(Path(path).read_text(encoding='utf-8')\n                       for _, path in sorted((supporting_files or {}).items()))\n        text += Path(input_file_path).read_text(encoding='utf-8')\n        return pex25d.read_text(text.encode('utf-8'), report=report)\n\ndef create_importer() -> Importer:\n    return Importer()\n'"}],"links":[],"hidden":false,"retry":false,"extra":{"severity":"normal","retries":[{"uid":"8f11852f11274b27","status":"passed","time":{"start":1794947871956,"stop":1794947871985,"duration":29}},{"uid":"a80658fe376bef35","status":"passed","time":{"start":1794947552928,"stop":1794947552943,"duration":15}}],"categories":[],"history":{"statistic":{"failed":0,"broken":0,"skipped":0,"passed":220,"unknown":0,"total":220},"items":[{"uid":"1da482b674279b94","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/1203/#testresult/1da482b674279b94","status":"passed","time":{"start":1794948051739,"stop":1794948051757,"duration":18}},{"uid":"23bb1d6ad04c74c7","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/1202/#testresult/23bb1d6ad04c74c7","status":"passed","time":{"start":1794935337743,"stop":1794935337772,"duration":29}},{"uid":"9efa021ba17ab546","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/1200/#testresult/9efa021ba17ab546","status":"passed","time":{"start":1794873616701,"stop":1794873616716,"duration":15}},{"uid":"bd8501006956b6ae","reportUrl":"https://iic-jku.github.io/klayout-pex/allure