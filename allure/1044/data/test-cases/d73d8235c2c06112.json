gnostics import DiagnosticsReport\n\nclass Importer:\n    \"\"\"Read PEX25D text split over named supporting files and the primary input.\"\"\"\n\n    def import_file(self, input_file_path: str, *,\n                    supporting_files: Optional[Mapping[str, str]] = None,\n                    options: Optional[Mapping[str, Any]] = None,\n                    report: Optional[DiagnosticsReport] = None) -> PEX25DFile:\n        from klayout_pex.plugin_api.v1 import ImporterError\n        raise ImporterError('unsupported construct')\n        text = ''.join(Path(path).read_text(encoding='utf-8')\n                       for _, path in sorted((supporting_files or {}).items()))\n        text += Path(input_file_path).read_text(encoding='utf-8')\n        return pex25d.read_text(text.encode('utf-8'), report=report)\n\ndef create_importer() -> Importer:\n    return Importer()\n'"}],"links":[],"hidden":false,"retry":false,"extra":{"severity":"normal","retries":[{"uid":"4727118f792d3a8","status":"passed","time":{"start":1793990527847,"stop":1793990527865,"duration":18}},{"uid":"f7395e783de88671","status":"passed","time":{"start":1793990511366,"stop":1793990511390,"duration":24}}],"categories":[],"history":{"statistic":{"failed":0,"broken":0,"skipped":0,"passed":101,"unknown":0,"total":101},"items":[{"uid":"f4b432b3265cab7e","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/1041/#testresult/f4b432b3265cab7e","status":"passed","time":{"start":1793990278469,"stop":1793990278498,"duration":29}},{"uid":"6aacd893a14478f5","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/1043/#testresult/6aacd893a14478f5","status":"passed","time":{"start":1793990347570,"stop":1793990347595,"duration":25}},{"uid":"5be3399f763e39af","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/1038/#testresult/5be3399f763e39af","status":"passed","time":{"start":1793989870340,"stop":1793989870370,"duration":30}},{"uid":"d4196facb8833b1e","reportUrl":"https://iic-jku.github.io/klayout-pex/allure