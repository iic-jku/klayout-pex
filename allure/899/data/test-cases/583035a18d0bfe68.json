"\"Read PEX25D text split over named supporting files and the primary input.\"\"\"\n\n    def import_file(self, input_file_path: str, *,\n                    supporting_files: Optional[Mapping[str, str]] = None,\n                    options: Optional[Mapping[str, Any]] = None,\n                    report: Optional[DiagnosticsReport] = None) -> PEX25DFile:\n        open(input_file_path + '.missing')\n        text = ''.join(Path(path).read_text(encoding='utf-8')\n                       for _, path in sorted((supporting_files or {}).items()))\n        text += Path(input_file_path).read_text(encoding='utf-8')\n        return pex25d.read_text(text.encode('utf-8'), report=report)\n\ndef create_importer() -> Importer:\n    return Importer()\n'"}],"links":[],"hidden":false,"retry":false,"extra":{"severity":"normal","retries":[{"uid":"184d20e6e47ed8df","status":"passed","time":{"start":1793276180319,"stop":1793276180341,"duration":22}},{"uid":"c4d4e178f4d81894","status":"passed","time":{"start":1793276174190,"stop":1793276174211,"duration":21}}],"categories":[],"history":{"statistic":{"failed":0,"broken":0,"skipped":0,"passed":10,"unknown":0,"total":10},"items":[{"uid":"9b6c8dbf9a507d0b","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/897/#testresult/9b6c8dbf9a507d0b","status":"passed","time":{"start":1793238269477,"stop":1793238269501,"duration":24}},{"uid":"6ec89fd4832cab65","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/896/#testresult/6ec89fd4832cab65","status":"passed","time":{"start":1793219060385,"stop":1793219060416,"duration":31}},{"uid":"d2feb892410dddf6","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/891/#testresult/d2feb892410dddf6","status":"passed","time":{"start":1793215005832,"stop":1793215005851,"duration":19}},{"uid":"2d17116707743155","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/892/#testresult/2d17116707743155","status":"passed","time":{"start":1793214409738,"stop":1793214409771,"duration":33}},{"uid":"d2046662