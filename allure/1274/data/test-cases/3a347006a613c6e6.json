PEX25D text split over named supporting files and the primary input.\"\"\"\n\n    def import_file(self, input_file_path: str, *,\n                    supporting_files: Optional[Mapping[str, str]] = None,\n                    options: Optional[Mapping[str, Any]] = None,\n                    report: Optional[DiagnosticsReport] = None) -> PEX25DFile:\n        from kpex.plugin_api.v1 import ImporterError\n        raise ImporterError('unsupported construct')\n        text = ''.join(Path(path).read_text(encoding='utf-8')\n                       for _, path in sorted((supporting_files or {}).items()))\n        text += Path(input_file_path).read_text(encoding='utf-8')\n        return pex25d.read_text(text.encode('utf-8'), report=report)\n\ndef create_importer() -> Importer:\n    return Importer()\n'"}],"links":[],"hidden":false,"retry":false,"extra":{"severity":"normal","retries":[{"uid":"c7c9453e7b837623","status":"passed","time":{"start":1795771899025,"stop":1795771899057,"duration":32}},{"uid":"aa9db27dd223499b","status":"passed","time":{"start":1795771887340,"stop":1795771887353,"duration":13}}],"categories":[],"history":{"statistic":{"failed":0,"broken":0,"skipped":0,"passed":14,"unknown":0,"total":14},"items":[{"uid":"228bdf8352e7c59b","reportUrl":"https://iic-jku.github.io/kpex/allure/1274/#testresult/228bdf8352e7c59b","status":"passed","time":{"start":1795771915591,"stop":1795771915608,"duration":17}},{"uid":"1ad5896f2946dc04","reportUrl":"https://iic-jku.github.io/kpex/allure/1273/#testresult/1ad5896f2946dc04","status":"passed","time":{"start":1795771693295,"stop":1795771693327,"duration":32}},{"uid":"1bf0a78437f27543","reportUrl":"https://iic-jku.github.io/kpex/allure/1271/#testresult/1bf0a78437f27543","status":"passed","time":{"start":1795752492599,"stop":1795752492629,"duration":30}},{"uid":"61f1dce9465b5221","reportUrl":"https://iic-jku.github.io/kpex/allure/1270/#testresult/61f1dce9465b5221","status":"passed","time":{"start":1795707957040,"stop":1795707957066,