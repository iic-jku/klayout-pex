nostics import DiagnosticsReport\n\nclass Importer:\n    \"\"\"Read PEX25D text split over named supporting files and the primary input.\"\"\"\n\n    def import_file(self, input_file_path: str, *,\n                    supporting_files: Optional[Mapping[str, str]] = None,\n                    options: Optional[Mapping[str, Any]] = None,\n                    report: Optional[DiagnosticsReport] = None) -> PEX25DFile:\n        from klayout_pex.plugin_api.v1 import ImporterError\n        raise ImporterError('unsupported construct')\n        text = ''.join(Path(path).read_text(encoding='utf-8')\n                       for _, path in sorted((supporting_files or {}).items()))\n        text += Path(input_file_path).read_text(encoding='utf-8')\n        return pex25d.read_text(text.encode('utf-8'), report=report)\n\ndef create_importer() -> Importer:\n    return Importer()\n'"}],"links":[],"hidden":false,"retry":false,"extra":{"severity":"normal","retries":[{"uid":"2b1b3d37ab83211a","status":"passed","time":{"start":1794594941821,"stop":1794594941843,"duration":22}},{"uid":"89e880e77d7e385b","status":"passed","time":{"start":1794594925321,"stop":1794594925333,"duration":12}}],"categories":[],"history":{"statistic":{"failed":0,"broken":0,"skipped":0,"passed":194,"unknown":0,"total":194},"items":[{"uid":"ae854a8b8baa395c","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/1170/#testresult/ae854a8b8baa395c","status":"passed","time":{"start":1794594897577,"stop":1794594897589,"duration":12}},{"uid":"b30d867c691ed014","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/1171/#testresult/b30d867c691ed014","status":"passed","time":{"start":1794594884275,"stop":1794594884301,"duration":26}},{"uid":"acf5883fd88592cb","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/1169/#testresult/acf5883fd88592cb","status":"passed","time":{"start":1794594875189,"stop":1794594875204,"duration":15}},{"uid":"15aeeb37d484f72","reportUrl":"https://iic-jku.github.io/klayout-pex/allure/